{
  "$description": "Tier 3: the main tab bar (bottom bar on phones, floating dock from md).",
  "color": {
    "$type": "color",
    "nav": {
      "bg": {
        "$value": "{color.surface.raised}"
      },
      "border": {
        "$value": "{color.border.default}"
      },
      "item-fg": {
        "$value": "{color.fg.muted}"
      },
      "item-fg-hover": {
        "$value": "{color.fg.default}"
      },
      "item-fg-current": {
        "$value": "{color.accent.default}",
        "$description": "The current page"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "nav": {
      "$value": "{radius.dock}"
    },
    "nav-item": {
      "$value": "{radius.prominent}"
    }
  },
  "shadow": {
    "$type": "shadow",
    "nav": {
      "$value": "{elevation.floating}"
    }
  }
}
