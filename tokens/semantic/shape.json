{
  "$description": "Tier 2: corner and elevation roles (ADR-0027).",
  "radius": {
    "$type": "dimension",
    "control": { "$value": "{radius.md}", "$description": "Buttons, toggles, small chips" },
    "container": { "$value": "{radius.lg}", "$description": "Cards, fields, notices" },
    "floating": {
      "$value": "{radius.xl}",
      "$description": "Popovers and items inside floating bars"
    },
    "dock": { "$value": "{radius.2xl}", "$description": "The floating tab bar" }
  },
  "elevation": {
    "$type": "shadow",
    "raised": { "$value": "{shadow.sm}", "$description": "Cards resting on the page" },
    "floating": { "$value": "{shadow.2xl}", "$description": "Popovers and the floating tab bar" }
  }
}
