{
  "$description": "Tier 2, dark theme (the only theme today). Semantic color roles; a light theme would be tokens/themes/light/ with the same names (ADR-0027).",
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{color.ink}"
      },
      "raised": {
        "$value": "{color.neutral.900}"
      },
      "overlay": {
        "$value": "{color.neutral.850}"
      },
      "selected": {
        "$value": "{color.teal.900}"
      },
      "glow": {
        "$value": "{color.sky.950}",
        "$description": "The backdrop glow rising from the bottom of the window on the app shell pages (design approved 2026-10-07, 'Sky rise'). Used mixed toward transparent, so text over it is never on more than this color."
      }
    },
    "fg": {
      "default": {
        "$value": "{color.neutral.50}"
      },
      "muted": {
        "$value": "{color.neutral.300}"
      },
      "placeholder": {
        "$value": "{color.neutral.400}"
      },
      "on-accent": {
        "$value": "{color.teal.950}"
      },
      "on-selected": {
        "$value": "{color.teal.50}"
      },
      "danger": {
        "$value": "{color.red.300}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.teal.400}"
      }
    },
    "info": {
      "$value": "{color.blue.300}"
    },
    "danger": {
      "$value": "{color.red.600}"
    },
    "contextual": {
      "$value": "{color.accent.default}",
      "$description": "The page accent (ADR-0020). Defaults to the brand accent; a tag-filtered list sets it to that tag's color."
    },
    "border": {
      "default": {
        "$value": "{color.neutral.700}"
      },
      "control": {
        "$value": "{color.neutral.600}"
      }
    },
    "focus": {
      "$value": "{color.blue.300}"
    },
    "tag": {
      "seen": {
        "$value": "{color.teal.400}",
        "$description": "Seen it"
      },
      "watchlist": {
        "$value": "{color.blue.300}",
        "$description": "Want to see"
      },
      "liked": {
        "$value": "{color.neutral.50}",
        "$description": "Like"
      },
      "disliked": {
        "$value": "{color.red.300}",
        "$description": "Dislike. The only red in the UI (ADR-0020)"
      }
    },
    "genre": {
      "$description": "Card tones per TMDB genre (design v2). Decorative; always paired with the genre name as text.",
      "default": {
        "$value": "{color.teal.400}"
      },
      "action": {
        "$value": "{color.orange.600}"
      },
      "adventure": {
        "$value": "{color.lime.600}"
      },
      "animation": {
        "$value": "{color.gold.600}"
      },
      "comedy": {
        "$value": "{color.gold.600}"
      },
      "crime": {
        "$value": "{color.indigo.600}"
      },
      "documentary": {
        "$value": "{color.green.600}"
      },
      "drama": {
        "$value": "{color.sky.600}"
      },
      "family": {
        "$value": "{color.lime.600}"
      },
      "fantasy": {
        "$value": "{color.violet.600}"
      },
      "history": {
        "$value": "{color.green.600}"
      },
      "horror": {
        "$value": "{color.violet.600}"
      },
      "music": {
        "$value": "{color.magenta.600}"
      },
      "mystery": {
        "$value": "{color.indigo.600}"
      },
      "romance": {
        "$value": "{color.magenta.600}"
      },
      "science-fiction": {
        "$value": "{color.cyan.600}"
      },
      "thriller": {
        "$value": "{color.orange.600}"
      },
      "tv-movie": {
        "$value": "{color.sky.600}"
      },
      "war": {
        "$value": "{color.orange.600}"
      },
      "western": {
        "$value": "{color.gold.600}"
      }
    },
    "print": {
      "paper": {
        "$value": "{color.cream.100}",
        "$description": "Printed-matter paper: stickers and labels drawn as physical objects"
      },
      "ink": {
        "$value": "{color.umber.950}",
        "$description": "Ink printed on that paper"
      }
    }
  }
}
