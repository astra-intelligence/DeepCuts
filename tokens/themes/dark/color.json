{
  "$description": "Tier 2, dark theme (the only theme). Semantic color roles on the Triple Feature palette (ADR-0040); a light theme would be tokens/themes/light/ with the same names (ADR-0027).",
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{color.ink.default}"
      },
      "raised": {
        "$value": "{color.ink.raised}"
      },
      "overlay": {
        "$value": "{color.ink.overlay}",
        "$description": "Hovered and focused rows inside raised surfaces (menus, suggestions), skeleton bars"
      }
    },
    "fg": {
      "default": {
        "$value": "{color.bone.default}"
      },
      "soft": {
        "$value": "{color.bone.soft}",
        "$description": "Body and lede text"
      },
      "muted": {
        "$value": "{color.dust}",
        "$description": "Secondary text and metadata"
      },
      "placeholder": {
        "$value": "{color.dust}"
      },
      "on-accent": {
        "$value": "{color.ink.default}",
        "$description": "Text on mustard fills"
      },
      "on-danger": {
        "$value": "{color.bone.default}",
        "$description": "Text on blood fills (CTAs, the match stamp, the logo)"
      },
      "danger": {
        "$value": "{color.red.300}",
        "$description": "Error text (field errors). Blood is too dark for small text"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.mustard.default}",
        "$description": "Labels, links, focus, utility buttons"
      },
      "hover": {
        "$value": "{color.mustard.hover}"
      }
    },
    "danger": {
      "$value": "{color.blood}",
      "$description": "Blood red: CTA fills, the match stamp, large headline text and error borders. About 3:1 on ink, so never small text (ADR-0040)"
    },
    "contextual": {
      "$value": "{color.accent.default}",
      "$description": "The page accent (ADR-0020). Defaults to the brand accent; a tag-filtered list sets it to that tag's color."
    },
    "border": {
      "default": {
        "$value": "{color.line.default}",
        "$description": "Structure lines and dividers (decorative)"
      },
      "strong": {
        "$value": "{color.line.strong}",
        "$description": "Dashed outlines of empty slots (decorative)"
      },
      "control": {
        "$value": "{color.dust}",
        "$description": "Outlines that identify a control (3:1)"
      },
      "emphasis": {
        "$value": "{color.bone.default}",
        "$description": "2-3px bone outlines on fields, buttons and the stamp ring"
      }
    },
    "focus": {
      "$value": "{color.mustard.default}"
    },
    "favourite": {
      "$value": "{color.mustard.default}",
      "$description": "Favourite films: the Top Ten (ADR-0035). Decorative; always next to its label"
    },
    "match": {
      "$description": "The match sticker's fill and text, in five steps from red to neon green by the pick's match (owner, 2026-10-13). Each step's text passes 4.5:1 on its fill (scripts/contrast-pairs.json); the match is always written on the sticker too.",
      "0": {
        "default": {
          "$value": "{color.blood}",
          "$description": "0\u201319%"
        },
        "fg": {
          "$value": "{color.fg.on-danger}"
        }
      },
      "20": {
        "default": {
          "$value": "{color.heat.20}",
          "$description": "20\u201339%"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      },
      "40": {
        "default": {
          "$value": "{color.heat.40}",
          "$description": "40\u201359%"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      },
      "60": {
        "default": {
          "$value": "{color.heat.60}",
          "$description": "60\u201379%"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      },
      "80": {
        "default": {
          "$value": "{color.heat.80}",
          "$description": "80\u2013100%"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      }
    },
    "shadow": {
      "$value": "{color.black}",
      "$description": "Hard offset shadows (ADR-0040)"
    },
    "tag": {
      "watchlist": {
        "$value": "{color.sky.300}",
        "$description": "Want to see"
      },
      "liked": {
        "$value": "{color.bone.default}",
        "$description": "Like"
      },
      "disliked": {
        "$value": "{color.red.300}",
        "$description": "Dislike. The only red in the UI (ADR-0020)"
      }
    },
    "genre": {
      "$description": "Card tones per TMDB genre (design v2). Decorative; always paired with the genre name as text.",
      "default": {
        "$value": "{color.dust}"
      },
      "action": {
