{
  "color": {
    "$type": "color",
    "surface": {
      "base": { "$value": "{color.ink}" },
      "raised": { "$value": "{color.neutral.900}" },
      "overlay": { "$value": "{color.neutral.850}" },
      "selected": { "$value": "{color.teal.900}" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.50}" },
      "secondary": { "$value": "{color.neutral.300}" },
      "placeholder": { "$value": "{color.neutral.400}" },
      "on-accent": { "$value": "{color.teal.950}" },
      "on-selected": { "$value": "{color.teal.50}" },
      "danger": { "$value": "{color.red.300}" }
    },
    "accent": {
      "primary": { "$value": "{color.teal.400}" },
      "secondary": { "$value": "{color.blue.300}" },
      "danger": { "$value": "{color.red.600}" }
    },
    "border": {
